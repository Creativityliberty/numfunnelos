# Run python3 scripts/init_env.py to create a secure .env.
POSTGRES_PASSWORD=GENERATE_ME
SESSION_SECRET=GENERATE_ME
INTEGRATION_KEY=GENERATE_ME

# Optional InsForge DEV event mirror: DO NOT use a BioDeck production project
INSFORGE_EVENT_MIRROR_ENABLED=false
INSFORGE_BASE_URL=
INSFORGE_ADMIN_API_KEY=
# Disable the local outbox worker for tests or if running a dedicated worker
WORKER_ENABLED=true

# InsForge DEV — optional private storage (bucket must already exist and be private)
INSFORGE_STORAGE_ENABLED=false
INSFORGE_STORAGE_BUCKET=num_funnel_assets
# Allowlist of previously reviewed server functions, e.g. safe-url-scan,num-ai-draft
INSFORGE_FUNCTION_ALLOWLIST=
INSFORGE_FUNCTION_SHARED_SECRET=
INSFORGE_AI_DRAFT_FUNCTION=
\n# Google sign-in through InsForge Auth (DEV only until manually tested)\nINSFORGE_GOOGLE_AUTH_ENABLED=false\nPUBLIC_APP_URL=http://localhost:8080\n# System recovery inbox (AgentMail), different from tenant inboxes\nAUTH_MAIL_AGENTMAIL_API_KEY=\nAUTH_MAIL_INBOX_ID=\n